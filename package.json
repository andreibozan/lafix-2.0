{
  "name": "lafix-mvp",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "db:generate": "npm run db:generate -w apps/web",
    "db:push": "npm run db:push -w apps/web",
    "codex:preflight": "node scripts/codex-preflight.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "npm run db:migrate -w apps/web",
    "db:local": "node scripts/local-db.mjs",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "auth:configure": "node scripts/configure-local-auth.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
