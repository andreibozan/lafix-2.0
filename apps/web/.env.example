DATABASE_URL="postgresql://lafix:YOUR_LOCAL_POSTGRES_PASSWORD@localhost:5432/lafix?schema=public"
AUTH_SECRET="replace-with-a-cryptographically-random-secret-of-at-least-32-chars"

# Exact website origin for cookie CSRF checks
APP_ORIGIN=http://localhost:3000

# Only synthetic data and simulated credits; leave disabled for live deployments.
BILLING_MODE=disabled

# Enable ONLY for local http://127.0.0.1 or localhost previews; never public hosts.
ALLOW_LOCAL_HTTP_AUTH=false

# Launch without lead fees or subscriptions. Paid mode is reserved for later.
MARKETPLACE_MODE=free

# Generate a separate, private 32-byte base64 encryption key. Retain it for restores.
AUTH_ENCRYPTION_KEY=
# Configure the verified sender in Render, never in GitHub.
RESEND_API_KEY=
MAIL_FROM=
